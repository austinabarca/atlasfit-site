---
// Smart link for ad QR codes: phones go straight to their app store,
// everything else gets both store buttons.
import CardPage from '../layouts/CardPage.astro';
import { detectPlatform, sanitizeSrc, storeUrl } from '../lib/storeLinks';
import { trackScan } from '../lib/trackScan';

export const prerender = false;

const src = sanitizeSrc(Astro.url.searchParams.get('src'));
const platform = detectPlatform(Astro.request.headers.get('user-agent'));
trackScan({ route: 'get', src, platform }, Astro.request);

// 302 + no-store: a cached or permanent redirect would stop repeat scans being
// counted and make the destination impossible to change later.
if (platform !== 'other') {
  return new Response(null, {
    status: 302,
    headers: { Location: storeUrl(platform, src), 'Cache-Control': 'no-store' },
  });
}
Astro.response.headers.set('Cache-Control', 'no-store');
---
<CardPage title="Get Atlas">
  <h1>Get <span class="grad">Atlas</span></h1>
  <p class="sub">Track workouts, train with AI coaching, and connect with lifters.</p>
  <a href={storeUrl('ios', src)} class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
    Download on the App Store
  </a>
  <a href={storeUrl('android', src)} class="btn btn-secondary">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-1.567l2.834 1.6a1 1 0 0 1 0 1.72l-2.834 1.6-2.535-2.46 2.535-2.46zM5.864 2.658L16.8 9.291l-2.302 2.302-8.634-8.935z"/>
    </svg>
    Get it on Google Play
  </a>
</CardPage>
